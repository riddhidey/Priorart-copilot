# Google Gemini API Key & Model (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Optional: EPO OPS (European Patent Office Open Patent Services) Free Tier Key & Secret
# (Free 4GB/month from https://developers.epo.org/)
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=

# Optional: Semantic Scholar API Key (Free tier available at https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=

# Supabase Authentication (From https://supabase.com/dashboard/project/_/settings/api)
# Provide your Supabase project URL and anon public key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Alternative aliases supported:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Firebase Authentication (From https://console.firebase.google.com/ -> Project Settings -> General -> Your apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
