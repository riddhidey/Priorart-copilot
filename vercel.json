{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-BACKEND.onrender.com/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/web/:path*"
    },
    {
      "source": "/login",
      "destination": "/web/login.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/web/callback.html"
    },
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/web/$1"
    }
  ]
}
